config_version=5

[application]

config/name="pixelated_sandbox"
run/main_scene="uid://g35v4ah5c2y2"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

